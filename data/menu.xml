<?xml version="1.0" encoding="UTF-8"?>

<openbox_menu xmlns="http://openbox.org/3.4/menu">

<!-- WindowServerWM :: placeholder root menu.
     The preferences entries (Openbox Configuration Manager / GNOME / KDE /
     Xfce settings) are gone: WindowServerWM's configuration is a hardcoded
     system asset, not user-editable. The real root menu will come from the
     lynxOS desktop (Finder) later. -->

<menu id="root-menu" label="WindowServerWM">
  <item label="Terminal">
    <action name="Execute">
      <command>xterm</command>
      <startupnotify><enabled>yes</enabled></startupnotify>
    </action>
  </item>
  <separator />
  <item label="Log Out">
    <action name="Exit">
      <prompt>yes</prompt>
    </action>
  </item>
</menu>

</openbox_menu>
